<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingLeanbackLauncher">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="@string/app_name" android:allowBackup="false" android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/fixture_icon" android:supportsRtl="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <service android:name=".HaystackDreamService" android:exported="true"
            android:label="@string/app_name" android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter><action android:name="android.service.dreams.DreamService" /></intent-filter>
            <meta-data android:name="android.service.dream" android:resource="@xml/dream" />
        </service>
    </application>
</manifest>
