# Direct image-provider keys. Set at least one. Keep real values only in the
# gitignored .env.local (recommended permissions: chmod 600 .env.local) or the
# injected process environment; never print them in setup checks or logs.
# Restart the Haystack server and launchd jobs after rotating any key.
# Get one at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Optional direct OpenAI and xAI credentials
# OPENAI_API_KEY=your-openai-api-key-here
# XAI_API_KEY=your-xai-api-key-here

# Optional: unique comma-separated subset/order (default: available keys in openai,gemini,xai order)
# HAYSTACK_IMAGE_PROVIDER_ORDER=openai,gemini,xai

# Optional: Custom output directory
# HAYSTACK_OUTPUT_DIR=~/.haystack/outputs

# Optional: Default Gemini model (gemini-3.1-flash-lite-image, gemini-3.1-flash-image, gemini-3-pro-image, or retiring gemini-2.5-flash-image)
# HAYSTACK_MODEL=gemini-3.1-flash-lite-image

# Optional: Stable Gemini model for extend-artwork cleanup and outpainting
# HAYSTACK_EXTEND_MODEL=gemini-3.1-flash-image

# Optional: Default aspect ratio (omit to match input image)
# HAYSTACK_ASPECT_RATIO=16:9

# Optional: Seed for more reproducible outputs
# HAYSTACK_SEED=42

# Optional: Max stored outputs
# HAYSTACK_MAX_OUTPUTS=24

# Optional: Lab UI server port (default: 4321)
# HAYSTACK_LAB_PORT=4321


# Daily stories are opt-in. No schedules are activated by installation.
# Requires configured HAYSTACK_IMAGE_DIR, LAT, LON, TIMEZONE.
HAYSTACK_STORY_ENABLED=false
# HAYSTACK_STORY_PREPARE_TIME=06:45
# HAYSTACK_STORY_DIR=/absolute/path/to/story-state
# HAYSTACK_CODEX_PATH=/opt/homebrew/bin/codex
# Optional root of the already-synced vault (handoff uses Europe/Madrid):
# HAYSTACK_TRAILER_DIR=/absolute/path/to/vault
